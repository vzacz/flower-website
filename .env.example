# Required — the app will not start a session without these.

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Shared password for signing in to the workspace.
ADMIN_PASSWORD=

# Email delivery for invoices. Both are required before the "Email Invoice"
# button can send; without them the app says email is not set up.
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address. Must be on a domain verified in Resend, otherwise Resend
# rejects the send. Falls back to ADMIN_EMAIL if unset.
INVOICE_FROM_EMAIL=
ADMIN_EMAIL=

# Optional — Supabase backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automatic daily backups (Vercel Cron -> /api/backup).
# Protects the backup endpoint: Vercel Cron sends this as a Bearer token, and the
# route refuses to run without it. Generate with: openssl rand -base64 32
CRON_SECRET=
# Where the daily backup file is emailed. Falls back to INVOICE_FROM_EMAIL if
# unset. Set this to the owner's inbox so the copy lands off-site.
BACKUP_TO_EMAIL=
